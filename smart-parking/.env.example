# Copy to .env and edit. Restart `npm run dev` after changes.

# true  = simulated data (no broker needed)
# false = connect to your real MQTT broker
VITE_USE_MOCK=true

# MQTT broker over WebSockets (ws:// or wss://)
VITE_MQTT_URL=ws://localhost:9001
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=

# Number of parking slots
VITE_SLOT_COUNT=3
# If a sensor sends only a number (cm), distance below this = occupied
VITE_OCCUPIED_THRESHOLD_CM=10

# Topics
VITE_TOPIC_SLOT_PREFIX=parking/slot          # parking/slot/1, parking/slot/2 ...
VITE_TOPIC_GATE_STATUS=parking/gate/status   # payload: OPEN | CLOSED
VITE_TOPIC_GATE_COMMAND=parking/gate/command # we publish: OPEN | CLOSE
VITE_TOPIC_STATS=parking/stats               # payload: {"entries":18,"exits":23}
VITE_TOPIC_ESP32_STATUS=parking/esp32/status # payload: online | offline
